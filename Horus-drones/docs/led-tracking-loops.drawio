<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.17">
  <diagram name="LED tracking" id="ledsimple">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="loop" value="LED centring loop" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f7f3fb;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=16;fontStyle=1;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="820" height="390" as="geometry"/></mxCell>
        <mxCell id="A" value="Take off" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="B" value="Hover in place and turn slowly,&lt;br&gt;looking for the pink LED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="250" y="170" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="C" value="Pink LED&lt;br&gt;spotted?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="230" y="290" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="D" value="Give up and land" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="E" value="See how far the LED is&lt;br&gt;from the middle of the view" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="190" y="510" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="F" value="Is it in&lt;br&gt;the middle?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="180" y="610" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="G" value="Turn left or right&lt;br&gt;toward it" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="560" y="615" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="H" value="Fly forward slowly" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="190" y="750" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="I" value="Can we still&lt;br&gt;see it?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="180" y="890" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="J" value="Stop and hover.&lt;br&gt;Wait for it to come back" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;verticalAlign=middle;align=center;dashed=0;" vertex="1" parent="1"><mxGeometry x="560" y="895" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="n1" value="Height is set at take-off&lt;br&gt;and never changes again.&lt;br&gt;&lt;br&gt;Only turning and flying&lt;br&gt;forward are controlled." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="n2" value="The flight controller keeps the drone level&lt;br&gt;and steady on its own, the whole time.&lt;br&gt;This page is only the LED behaviour." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="560" y="1050" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="n3" value="The camera only tells us WHICH WAY&lt;br&gt;the LED is — never how far away.&lt;br&gt;Nothing here knows when to stop." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="no, after a while" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="C" target="D"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="C" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="not yet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="G"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="look again" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="H"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="H" target="I"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="yes — keep going" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="I" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2;dashed=0;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="I" target="J"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="it comes back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;fontSize=13;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="J" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
